{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "French vACC Controller Pack Installer",
  "version": "0.2.0",
  "identifier": "fr.vacc.controller-pack-installer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "French vACC Controller Pack Installer",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Installs and updates the French vACC controller pack",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/vaccfr/Sector-Files/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1NDI5RDRCQkQ3MkIwOEMKUldTTXNISzlTNTFDMVpZa1JwaGpIRUVia1d5RHhReGlFQnlSZ2hOV2ZXVVc4UTJKMTBpMVhMYk8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
